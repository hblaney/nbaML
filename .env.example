# The Odds API — leave blank until Henry adds a real key locally / as a secret.
# Never commit a real key.
ODDS_API_KEY=
ODDS_REGIONS=us
ODDS_MARKETS=h2h,spreads,totals

# Player prop markets (v1.5) — used by `odds pull-props` / event odds endpoint.
# Paid Odds API tier may be required. Documented keys:
#   player_points, player_rebounds, player_assists, player_threes,
#   player_points_rebounds_assists
ODDS_PROP_MARKETS=player_points,player_rebounds,player_assists,player_threes,player_points_rebounds_assists

# Optional override for local data root (default: ./data)
# NBA_BETTING_DATA_DIR=
